{
  "name": "universal-file-converter",
  "version": "5.0.0",
  "description": "Uni Companion: a fast, private, offline-first desktop app that converts audio, video, images and documents, downloads media with yt-dlp, and keeps your files organised. Windows, macOS and Linux.",
  "main": "src/main/index.js",
  "homepage": "https://github.com/Hasan580/universial-file-converter",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hasan580/universial-file-converter.git"
  },
  "bugs": {
    "url": "https://github.com/Hasan580/universial-file-converter/issues"
  },
  "keywords": [
    "file-converter",
    "ffmpeg",
    "yt-dlp",
    "electron",
    "audio-converter",
    "video-converter",
    "image-converter",
    "pdf-tools",
    "media-downloader",
    "cross-platform"
  ],
  "author": {
    "name": "Hasan580",
    "email": "hassanazawi50@gmail.com",
    "url": "https://github.com/Hasan580"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node scripts/make-icons.js",
    "test": "node --test test/",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "lint": "eslint src scripts test",
    "test:preload": "node scripts/gen-preload.js --check"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cheerio": "^1.2.0",
    "docx": "^9.5.1",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0",
    "heic-decode": "^2.1.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.7.284",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
